{
  "expo": {
    "name": "Crohnic",
    "slug": "crohnic",
    "scheme": "crohnic",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F4F6EE",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tr.com.f28.crohnic",
      "infoPlist": {
        "NSCameraUsageDescription": "Crohnic, yemeğinin ya da menünün fotoğrafını çekip sana uygun olup olmadığını söylemek için kamerayı kullanır.",
        "NSPhotoLibraryUsageDescription": "Crohnic, galerinden seçtiğin yemek ve menü fotoğraflarını analiz etmek için fotoğraflarına erişir.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "tr"
      },
      "icon": "./assets/app.icon"
    },
    "android": {
      "package": "tr.com.f28.crohnic",
      "adaptiveIcon": {
        "backgroundColor": "#F4F6EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 170,
          "backgroundColor": "#F4F6EE"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Crohnic, yemeğinin ya da menünün fotoğrafını çekip sana uygun olup olmadığını söylemek için kamerayı kullanır.",
          "photosPermission": "Crohnic, galerinden seçtiğin yemek ve menü fotoğraflarını analiz etmek için fotoğraflarına erişir."
        }
      ],
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9928883a-c711-4a14-8053-9edd6b87b1b1"
      }
    },
    "owner": "batuhanbecel",
    "updates": {
      "url": "https://u.expo.dev/9928883a-c711-4a14-8053-9edd6b87b1b1"
    }
  }
}
